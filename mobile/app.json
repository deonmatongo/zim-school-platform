{
  "expo": {
    "name": "ZimSchool Parent",
    "slug": "zimschool-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "zimschool",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a5276"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zimschools.parent"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a5276"
      },
      "package": "com.zimschools.parent"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        { "backgroundColor": "#1a5276", "imageResizeMode": "contain" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
